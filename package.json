{
  "name": "bandsync-live-stage-synchroniser",
  "private": true,
  "version": "1.0.0",
  "description": "Professional real-time teleprompter, stage synchroniser, and concert setlist management engine.",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vite": "^8.2.1"
  }
}
