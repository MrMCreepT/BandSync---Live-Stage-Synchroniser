# ==========================================
# BandSync — Environment Configuration
# ==========================================

# GEMINI_API_KEY: Required for AI Song & Setlist parsing / auto-charting.
# Obtain a key from Google AI Studio / Gemini API Console.
GEMINI_API_KEY="your_api_key_here"

# APP_URL: Base URL for web and websocket connections (e.g. http://localhost:3000)
APP_URL="http://localhost:3000"

